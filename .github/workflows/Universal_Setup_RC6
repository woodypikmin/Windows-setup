name: "Pikmin Pilot Universal Setup RC6"

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-universal-runtime:
    runs-on: windows-latest
    env:
      PIKMIN_BACKEND_URL: ${{ vars.PIKMIN_BACKEND_URL }}
      EXPECTED_PAIR_SHA256: '0edd085d0e98b07f80e94d67737d7e8e150c1e14d63b1170e77b4d54e8b5f847'
      EXPECTED_SOURCE_MARKER: 'RC6_UNIVERSAL_DYNAMIC_V2'
    steps:
      - uses: actions/checkout@v4

      - name: Verify exact RC6 Universal source
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $path = 'WindowsSetup/src/main.rs'
          Write-Host "Commit: $(git rev-parse HEAD)"
          Write-Host "Source path: $path"
          if (-not (Test-Path $path)) { throw "Missing $path" }

          $src = Get-Content $path -Raw
          Write-Host "=== source identity ==="
          Select-String -Path $path -Pattern 'RC6_UNIVERSAL_DYNAMIC_V2|UNIVERSAL_SETUP_REVISION|SETUP_PROTOCOL|Universal Release Client' | ForEach-Object { Write-Host $_.Line }

          if (-not $src.Contains($env:EXPECTED_SOURCE_MARKER)) {
            throw "STOP: WindowsSetup/src/main.rs is NOT the hard-reset RC6 Universal source. Expected marker: $env:EXPECTED_SOURCE_MARKER"
          }
          if ($src.Contains('EMBEDDED_IPA')) {
            throw 'STOP: embedded IPA source detected.'
          }
          if ($src.Contains("app_version: &'a str")) {
            throw 'STOP: old RC4 request model detected (app_version is still compiled into request).'
          }
          if (-not $src.Contains('setup_protocol: u8')) {
            throw 'STOP: setup_protocol field missing.'
          }
          if (-not $src.Contains('const SETUP_PROTOCOL: u8 = 2;')) {
            throw 'STOP: protocol 2 marker missing.'
          }
          if (-not $src.Contains('request_cloud_job')) {
            throw 'STOP: runtime cloud job client missing.'
          }
          if (-not $src.Contains('COMPILED_BACKEND_URL')) {
            throw 'STOP: runtime backend support missing.'
          }
          if (-not $env:PIKMIN_BACKEND_URL) {
            throw 'STOP: B repo variable PIKMIN_BACKEND_URL is empty.'
          }
          Write-Host 'PASS: exact RC6 Universal source confirmed.'

      - name: Verify pairing helper
        shell: pwsh
        run: |
          $pair = 'WindowsSetup/assets/PikminPilotPairingHelper.exe'
          if (-not (Test-Path $pair)) { throw "Missing $pair" }
          $pairHash = (Get-FileHash $pair -Algorithm SHA256).Hash.ToLowerInvariant()
          Write-Host "PairingHelper SHA256: $pairHash"
          if ($pairHash -ne $env:EXPECTED_PAIR_SHA256) { throw "Wrong pairing helper: $pairHash" }

      - uses: dtolnay/rust-toolchain@stable
        with:
          toolchain: 1.92.0

      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: WindowsSetup

      - name: Resolve exact idevice 0.1.61
        working-directory: WindowsSetup
        shell: pwsh
        run: |
          cargo generate-lockfile
          $tree = cargo tree -p idevice
          $tree
          if (($tree | Select-String -SimpleMatch 'idevice v0.1.61').Count -lt 1) { throw 'idevice pin changed' }

      - name: Build RC6 Universal Setup
        working-directory: WindowsSetup
        shell: pwsh
        run: cargo build --release --locked

      - name: Assemble delivery
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force delivery | Out-Null
          Copy-Item WindowsSetup/target/release/PikminPilotSetup.exe delivery/PikminPilotSetup.exe
          $hash = (Get-FileHash delivery/PikminPilotSetup.exe -Algorithm SHA256).Hash.ToLowerInvariant()
          "SHA256=$hash" | Set-Content -Encoding ASCII delivery/SHA256.txt
          @"
          Pikmin Pilot Universal Setup RC6
          Client marker: RC6_UNIVERSAL_DYNAMIC_V2
          App version is selected by the backend at runtime.
          PikminPilot.ipa is NOT embedded in this executable.
          "@ | Set-Content -Encoding UTF8 delivery/README.txt
          Write-Host "Built Universal EXE SHA256: $hash"

      - uses: actions/upload-artifact@v4
        with:
          name: PikminPilot-Universal-Setup-RC6
          path: delivery
